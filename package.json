{
  "name": "pdf-copilot",
  "version": "0.3.3",
  "private": true,
  "type": "module",
  "description": "A lightweight Edge/Chrome PDF reading companion with an optional Windows Codex bridge",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:lite": "node scripts/build.mjs --math=plain",
    "build:host": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-host.ps1",
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/check.mjs",
    "check:lite": "node scripts/check.mjs --math=plain",
    "package": "node scripts/package.mjs",
    "test:upgrade": "node scripts/upgrade-smoke.mjs",
    "test:acceptance": "node scripts/acceptance-smoke.mjs",
    "test:context": "node scripts/context-smoke.mjs"
  },
  "dependencies": {
    "katex": "0.19.0",
    "pdfjs-dist": "6.4.299"
  }
}
